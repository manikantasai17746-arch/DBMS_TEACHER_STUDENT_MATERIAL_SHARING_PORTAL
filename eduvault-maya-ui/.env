# Copy this file to .env for local development and fill in real values.
# On Render, set these under: Service -> Environment -> Environment Variables
# instead of using a .env file at all. NEVER commit a real .env file.

# ---------------------------------------------------------------------------
# Session signing (required for real deployments)
# ---------------------------------------------------------------------------
# Signs the login tokens issued to teachers/students/admin, and the
# short-lived Enrollment Code verification tokens. Without it, the server
# generates a random secret at startup, which invalidates every session on
# restart. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=a1af1717a8453e9623ba766b81c66867dc50c59660af4fab372fba7b459c29e6

# ---------------------------------------------------------------------------
# Port (Render sets this automatically -- you don't need to set it there)
# ---------------------------------------------------------------------------
# PORT=3000

# ---------------------------------------------------------------------------
# Employee Enrollment Code emails (Gmail SMTP)
# ---------------------------------------------------------------------------
# MAIL_APP_PASSWORD must be a Gmail App Password, NOT your normal Gmail
# password: https://myaccount.google.com/apppasswords (requires 2-Step
# Verification to be enabled on the sending Gmail account).
MAIL_USER=eduvault.project218@gmail.com
MAIL_APP_PASSWORD=myhsrwhjlegaipuv
# Optional: display name in the "From" header
MAIL_FROM_NAME=EduVault

# Enrollment Code behavior (optional -- sensible defaults are used if unset)
# ENROLLMENT_CODE_TTL_MINUTES=15
# ENROLLMENT_RESEND_COOLDOWN_SEC=60
# ENROLLMENT_MAX_REQUESTS_PER_HOUR=5

# ---------------------------------------------------------------------------
# Preconfigured system administrator
# ---------------------------------------------------------------------------
# The admin account is seeded automatically on startup with these
# credentials (falling back to mani@1774admin / mani@1774 if unset). Since
# that fallback password is documented publicly, set your own values here
# for any real deployment.
# ADMIN_EMP_ID=mani@1774admin
# ADMIN_PASSWORD=mani@1774
# ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# File storage (see lib/storage.js for full explanation)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local (default) writes uploads to disk. On Render, local
# disk is wiped on every redeploy UNLESS you attach a Render Disk (a
# persistent volume) and point UPLOAD_DIR at its mount path.
# STORAGE_DRIVER=local
# UPLOAD_DIR=/var/data/uploads

# STORAGE_DRIVER=s3 streams uploads to any S3-compatible bucket (AWS S3,
# Cloudflare R2, Backblaze B2, ...) instead -- recommended for Render, since
# it survives redeploys and scaling. Requires: npm install @aws-sdk/client-s3
# STORAGE_DRIVER=s3
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=                 # leave blank for real AWS S3; set for R2/B2/MinIO
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional: public URL of teacher register page (used in invitation emails)
# PUBLIC_REGISTER_URL=https://your-app.onrender.com/teacher-register.html

